---
/**
 * Blog Author Template Page
 * Displays author info and their posts
 */
import Layout from "@layouts/Layout.astro";
import { formatDate } from "@utils/index";
import { getPostsByAuthor, getAuthor, getLayoutData } from "@utils/sanity";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/blog");
}

const [{ data: author }, layoutSanity] = await Promise.all([
  getAuthor(slug, Astro.request),
  getLayoutData(Astro.request),
]);

if (!author) {
  return Astro.redirect("/blog");
}

const { data: posts } = await getPostsByAuthor(author._id, Astro.request);

const title = `${author.name} - Blog Author`;
---

<Layout title={title} layoutSanity={layoutSanity}>
  <div class="body-container-wrapper">
    <div class="body-container body-container--blog">
      
      <!-- Author Header -->
      <div class="blog-author-header">
        <nav class="blog-post__breadcrumbs">
          <a class="blog-header__tag" href="/blog">Blog</a>
          <span>/</span>
          <span class="blog-header__tag blog-header__tag--active">Author</span>
        </nav>
        
        <div class="blog-author-profile stack items-center">
          {author.avatar?.url && (
            <img 
              src={author.avatar.url} 
              alt={author.name} 
              class="blog-author-avatar"
              loading="lazy"
            />
          )}
          
          <div class="blog-author-info">
            <h1 class="blog-author-name">{author.name}</h1>
            
            {author.bio && (
              <p class="blog-author-bio">{author.bio}</p>
            )}
            
            <div class="blog-author-links flex flex-wrap justify-center">
              {author.website && (
                <a href={author.website} target="_blank" rel="noopener noreferrer">
                  🌐 Website
                </a>
              )}
              {author.twitter && (
                <a href={`https://twitter.com/${author.twitter}`} target="_blank" rel="noopener noreferrer">
                  𝕏 @{author.twitter}
                </a>
              )}
              {author.linkedin && (
                <a href={author.linkedin} target="_blank" rel="noopener noreferrer">
                  💼 LinkedIn
                </a>
              )}
            </div>
          </div>
        </div>
        
        <p class="blog-author-count">{posts?.length || 0} articles</p>
      </div>
      
      <!-- Posts Grid -->
      <div class="blog-index">
        {posts && posts.length > 0 ? (
          posts.map((post) => {
            const postDate = post.publishedAt || post._createdAt;
            const topic = post.topics?.filter(t => t != null)?.[0];
            return (
              <article class="blog-index__post">
                {post.featuredImage?.asset?.url && (
                  <a href={`/blog/${post.slug.current}`} class="blog-index__post-image">
                    <img 
                      src={post.featuredImage.asset.url} 
                      alt={post.featuredImage.alt || post.title || ''} 
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="blog-index__post-content">
                  {topic && (
                    <a class="blog-header__tag" href={`/blog/topic/${topic.slug?.current}`}>
                      {topic.name}
                    </a>
                  )}
                  <h2 class="blog-index__post-title">
                    <a href={`/blog/${post.slug.current}`}>{post.title}</a>
                  </h2>
                  {post.excerpt && (
                    <p class="blog-index__post-excerpt">{post.excerpt}</p>
                  )}
                  <div class="blog-index__post-content-meta">
                    <span>{formatDate(postDate)}</span>
                  </div>
                </div>
              </article>
            );
          })
        ) : (
          <p class="blog-no-posts">No articles found by this author.</p>
        )}
      </div>
      
    </div>
  </div>
</Layout>

<style>
  .blog-author-header {
    text-align: center;
    padding: var(--spacing-12) 0;
    margin-block-end: var(--spacing-8);
  }

  .blog-author-profile {
    gap: var(--spacing-6);
    margin: var(--spacing-6) 0;
  }

  @media (min-width: 768px) {
    .blog-author-profile {
      flex-direction: row;
      justify-content: center;
      text-align: left;
    }
  }

  .blog-author-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
  }

  .blog-author-info {
    max-width: 500px;
  }

  .blog-author-name {
    font-size: var(--font-size-32);
    color: var(--primary-50);
    margin: 0 0 var(--spacing-2);
  }

  .blog-author-bio {
    font-size: var(--font-size-16);
    color: var(--neutral-58);
    margin: 0 0 var(--spacing-4);
    line-height: var(--line-height-26);
  }

  .blog-author-links {
    gap: var(--spacing-4);
  }

  @media (min-width: 768px) {
    .blog-author-links {
      justify-content: flex-start;
    }
  }

  .blog-author-links a {
    color: var(--cyan-50);
    text-decoration: none;
    font-size: var(--font-size-14);
  }

  .blog-author-links a:hover {
    text-decoration: underline;
  }

  .blog-author-count {
    font-size: var(--font-size-14);
    color: var(--neutral-43);
    margin-block-start: var(--spacing-4);
  }

  .blog-no-posts {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--spacing-12);
    color: var(--neutral-58);
  }
</style>

