---
import { cleanStega } from "@utils/stega";

interface FeatureItem {
  _key?: string;
  // Text content
  eyebrow?: string;
  title?: string;
  text?: string;
  // Image
  image?: {
    asset?: { url?: string };
  };
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  imageRatio?: 'aspect-square' | 'aspect-video';
  // Stats
  showStats?: boolean;
  statsNumber?: string;
  statsText?: string;
  statsIcon?: string;
  // Quote
  showQuote?: boolean;
  quoteText?: string;
  quoteAuthor?: string;
  quoteAuthorTitle?: string;
  quoteImageType?: 'avatar' | 'logo';
  quoteImage?: {
    asset?: {
      url?: string;
      metadata?: { dimensions?: { width?: number; height?: number } };
    };
  };
  quoteImageAlt?: string;
  // CTA
  showCta?: boolean;
  ctaText?: string;
  ctaLink?: string;
  ctaOpenInNewTab?: boolean;
  ctaIcon?: string;
  ctaIconPosition?: 'left' | 'right';
  ctaKind?: 'primary' | 'secondary' | 'tertiary' | 'ghost' | 'gx_score';
}

interface Props {
  items?: FeatureItem[];
  theme?: 'light' | 'dark' | 'gxscore';
  textAlignment?: 'LEFT' | 'CENTER' | 'RIGHT';
  eyebrowType?: string;
  eyebrowStyle?: 'red' | 'gradient';
  headingType?: string;
  displayType?: string;
  textType?: 'xs' | 'sm' | 'base' | 'lg' | '2xl';
  id?: string;
}

const {
  items = [],
  theme = 'dark',
  textAlignment = 'LEFT',
  eyebrowType = 'h2',
  eyebrowStyle = 'red',
  headingType = 'h3',
  displayType = 'h2',
  textType = 'base',
  id = 'features-stacked-content'
} = Astro.props;

// Theme-based text colors
const getTextColor = (themeColor: string) => {
  switch (themeColor) {
    case 'light':
      return 'text-neutral-white';
    case 'gxscore':
      return 'text-gx-80';
    default:
      return 'text-primary-50';
  }
};

const getEyebrowColor = (themeColor: string) => {
  switch (themeColor) {
    case 'gxscore':
      return 'text-gx-90';
    default:
      return 'text-secondary-50';
  }
};

const getBorderColor = (themeColor: string) => {
  switch (themeColor) {
    case 'gxscore':
      return 'border-bar-gxscore';
    default:
      return 'border-bar-default';
  }
};

// Button style classes based on kind
const getButtonClasses = (kind?: string) => {
  const baseClasses = 'relative inline-flex items-center cursor-pointer select-none appearance-none no-underline text-base font-semibold tracking-tight transition ease-in-out duration-300 w-full stacked-cta whitespace-nowrap';
  
  switch (kind) {
    case 'primary':
      return `${baseClasses} bg-secondary-50 text-neutral-white padding-inline-6 padding-block-3 rounded-full stacked-btn-primary`;
    case 'secondary':
      return `${baseClasses} bg-transparent border-2 border-secondary-50 text-secondary-50 padding-inline-6 padding-block-3 rounded-full stacked-btn-secondary`;
    case 'tertiary':
      return `${baseClasses} bg-primary-50 text-neutral-white padding-inline-6 padding-block-3 rounded-full stacked-btn-tertiary`;
    case 'gx_score':
      return `${baseClasses} bg-gx-90 text-gx-10 padding-inline-6 padding-block-3 rounded-full stacked-btn-gxscore`;
    case 'ghost':
    default:
      return `${baseClasses} bg-transparent ${getTextColor(theme)} padding-block-2 font-serif`;
  }
};

const textColorClass = getTextColor(theme);
const eyebrowColorClass = getEyebrowColor(theme);
const borderColorClass = getBorderColor(theme);
const alignmentClass = `text-${textAlignment.toLowerCase()}`;
const eyebrowStyleClass = eyebrowStyle === 'gradient' ? 'gradient' : 'text-secondary-50';
---

<section id={cleanStega(id)} class="features-stacked-content grid gap-7" data-sanity-edit-target>
  {(items ?? []).map((item, index) => {
    // PRESERVE stega in visible text content for visual editing click-to-edit
    // Only clean stega for values used in CSS classes, URLs, or HTML attributes
    const eyebrow = item.eyebrow; // Keep stega for click-to-edit
    const title = item.title; // Keep stega for click-to-edit
    const text = item.text; // Keep stega for click-to-edit
    const imageUrl = item.image?.asset?.url;
    const cleanImageAlt = cleanStega(item.imageAlt); // Clean for alt attribute
    const position = cleanStega(item.imagePosition) || 'left'; // Clean for logic
    const isImageRight = position === 'right';
    
    // Dynamic heading tag - clean for HTML tag names
    const HeadingTag = cleanStega(headingType) || 'h3';
    const EyebrowTag = cleanStega(eyebrowType) || 'h2';
    
    return (
      <div class="features-stacked-row grid grid-cols-1 gap-4 items-center" data-image-position={isImageRight ? 'right' : 'left'} data-sanity-edit-target>
        <div class="content-panel order-last grid gap-4">
          <header class={`grid gap-4 ${alignmentClass} ${textColorClass}`}>
            {eyebrow && (
              <div data-sanity-edit-target>
                <Fragment set:html={`<${EyebrowTag} class="${eyebrowColorClass} ${eyebrowStyleClass} uppercase font-extrabold small"><span>${eyebrow}</span></${EyebrowTag}>`} />
              </div>
            )}
            {title && (
              <div data-sanity-edit-target>
                <Fragment set:html={`<${HeadingTag} class="${displayType}-heading margin-block-0">${title}</${HeadingTag}>`} />
              </div>
            )}
            {text && (
              <div class={`main-text text-${cleanStega(textType)}`} data-sanity-edit-target>
                <p>{text}</p>
              </div>
            )}
          </header>
          
          {/* Stats Section */}
          {item.showStats && item.statsNumber && (
            <div class={`left-border-bar ${borderColorClass} stacked-border-left padding-inline-start-3 margin-block-2`} data-sanity-edit-target>
              <div class="flex items-end gap-col-2">
                <span class={`text-stat ${textColorClass}`} data-sanity-edit-target>{item.statsNumber}</span>
                {item.statsIcon && (
                  <span set:html={item.statsIcon} />
                )}
              </div>
              {item.statsText && (
                <div class={textColorClass} set:html={item.statsText} data-sanity-edit-target />
              )}
            </div>
          )}
          
          {/* Quote Section */}
          {item.showQuote && item.quoteText && (
            <div class={`grid gap-3 left-border-bar ${borderColorClass} stacked-steps-grid padding-inline-start-3 margin-block-2`} data-sanity-edit-target>
              <div class={textColorClass} data-sanity-edit-target>{item.quoteText}</div>
              <div class="flex items-center gap-3">
                {item.quoteImage?.asset?.url && (
                  <figure class={item.quoteImageType === 'avatar'
                    ? 'quote-avatar rounded-full bg-neutral-white grid items-center overflow-hidden'
                    : 'quote-logo w-auto h-auto grid items-center'} data-sanity-edit-target>
                    <img 
                      src={item.quoteImage.asset.url} 
                      alt={cleanStega(item.quoteImageAlt) || ''} 
                      class="object-cover" 
                      width={item.quoteImageType === 'avatar' ? 72 : (item.quoteImage?.asset?.metadata?.dimensions?.width ?? 130)}
                      height={item.quoteImageType === 'avatar' ? 72 : (item.quoteImage?.asset?.metadata?.dimensions?.height ?? 130)}
                      loading="lazy"
                      data-sanity-edit-target
                    />
                  </figure>
                )}
                <div class={`font-semibold ${textColorClass}`}>
                  {item.quoteAuthor && (
                    <div class="text-base font-semibold block" data-sanity-edit-target>{item.quoteAuthor}</div>
                  )}
                  {item.quoteAuthorTitle && (
                    <div class="text-base font-normal" data-sanity-edit-target>{item.quoteAuthorTitle}</div>
                  )}
                </div>
              </div>
            </div>
          )}
          
          {/* CTA Section */}
          {item.showCta && item.ctaLink && (
            <div class="button-wrapper margin-block-2">
              <a 
                class={`${getButtonClasses(cleanStega(item.ctaKind))}`}
                href={cleanStega(item.ctaLink)}
                target={item.ctaOpenInNewTab ? '_blank' : undefined}
                rel={item.ctaOpenInNewTab ? 'noopener' : undefined}
                data-sanity-edit-target
              >
                {item.ctaIcon && cleanStega(item.ctaIconPosition) === 'left' && (
                  <div class="flex justify-center items-center margin-inline-end-2">
                    <Fragment set:html={item.ctaIcon} />
                  </div>
                )}
                <span class="blue-30">{item.ctaText || 'Learn more'}</span>
                {item.ctaIcon && cleanStega(item.ctaIconPosition) !== 'left' && (
                  <div class="flex justify-center items-center margin-inline-end-0 margin-inline-start-2 order-1">
                    <Fragment set:html={item.ctaIcon} />
                  </div>
                )}
              </a>
            </div>
          )}
        </div>
        
        {/* Feature Image */}
        {imageUrl ? (
          <figure class={`feature-image-figure ${cleanStega(item.imageRatio) === 'aspect-video' ? 'img-aspect-video' : 'img-aspect-square'} js-slide-in js-slidein-end`} data-sanity-edit-target>
            {/* Hidden span with stega-encoded imageAlt for visual editing click-to-edit */}
            <span class="sr-only">{item.imageAlt || 'Feature image'}</span>
            <img
              src={imageUrl}
              alt={cleanImageAlt || cleanStega(title) || ''}
              class="object-cover w-full h-full"
              width={612}
              height={612}
              loading="lazy"
              data-sanity-edit-target
            />
          </figure>
        ) : (
          <div class="feature-image-placeholder flex-center flex-col" data-sanity-edit-target>
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span>Select an image</span>
          </div>
        )}
      </div>
    );
  })}
</section>

<style>
  @property --gradient-color-1 {
    syntax: "<color>";
    inherits: false;
    initial-value: hsl(7, 100%, 52%);
  }
  
  @property --gradient-color-2 {
    syntax: "<color>";
    inherits: false;
    initial-value: hsl(265, 90%, 59%);
  }
  
  @property --gradient-color-3 {
    syntax: "<color>";
    inherits: false;
    initial-value: hsl(218, 93%, 50%);
  }
  
  @property --gradient-color-4 {
    syntax: "<color>";
    inherits: false;
    initial-value: hsl(218, 93%, 50%);
  }
  
  @property --gradient-color-5 {
    syntax: "<color>";
    inherits: false;
    initial-value: hsla(183, 100%, 61%, 0.6);
  }
  
  @property --gradient-color-6 {
    syntax: "<color>";
    inherits: false;
    initial-value: hsl(183, 100%, 61%);
  }
  
  header:has(.gradient) {
    .gradient > span {
      background: linear-gradient(
        to right in oklch,
        var(--gradient-color-1) 0%,
        var(--gradient-color-2) 22%,
        var(--gradient-color-3) 42%,
        var(--gradient-color-4) 82%,
        var(--gradient-color-5) 100%,
        var(--gradient-color-6) 104%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
  }
  
  .blue-30 {
    color: var(--primary-50);
  }
  
  .main-text p {
    font-size: var(--font-size-18);
  }
  
  .small {
    font-size: var(--font-size-14);
    line-height: var(--line-height-22);
  }
  
  .h2-heading {
    font-size: var(--font-size-36);
    line-height: var(--line-height-18);
    font-weight: var(--font-weight-700);
  }
  
  @media (min-width: 768px) {
    .h2-heading {
      font-size: var(--font-size-48);
      line-height: var(--line-height-16);
    }
  }
  
  .js-slide-in {
    opacity: 1;
  }
  
  .features-stacked-content figure img {
    border-radius: 0.5rem;
  }
  
  /* Placeholder shown when no image is selected */
  .feature-image-placeholder {
    gap: var(--spacing-3);
    width: 100%;
    min-height: 200px;
    padding: var(--spacing-8);
    background: linear-gradient(135deg, var(--gray-200) 0%, var(--gray-300) 100%);
    border: 2px dashed var(--gray-400);
    border-radius: 1rem;
    color: var(--gray-500);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-500);
  }

  .feature-image-placeholder svg {
    opacity: 0.5;
  }

  /* Screen reader only - visually hidden but accessible for stega detection */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

@media (min-width: 640px) {
  .stacked-cta { width: auto; }
}

@media (min-width: 768px) {
  .stacked-border-left,
  .stacked-steps-grid,
  .button-wrapper { margin-block: var(--spacing-3); }
  .features-stacked-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .features-stacked-row[data-image-position="right"] .content-panel { order: -1; }
  .features-stacked-row[data-image-position="left"] .feature-image-figure,
  .features-stacked-row[data-image-position="left"] .feature-image-placeholder { order: -1; }
}

/* Left border bar (replaces before: pseudo-element utilities) */
.left-border-bar {
  position: relative;
  padding-left: 0; /* padding-inline-start-3 handles it */
}
.left-border-bar::before {
  content: '';
  position: absolute;
  width: 2px;
  height: 100%;
  top: 0;
  left: 0;
}
.border-bar-default::before { background-color: var(--secondary-50); }
.border-bar-gxscore::before { background-color: var(--gx-90); }

/* Image aspect ratios */
.img-aspect-square > img { aspect-ratio: 1 / 1; }
.img-aspect-video > img { aspect-ratio: 16 / 9; }

/* Quote image sizes */
.quote-avatar { width: 72px; height: 72px; }
.quote-logo { max-width: 130px; }

/* Main text list styles */
.main-text > ul { list-style: disc; list-style-position: inside; margin-top: var(--spacing-4); }

/* CTA button should left-align within wrapper */
.button-wrapper > a { justify-content: flex-start; }

/* Button hover states */
.stacked-btn-primary:hover  { background-color: var(--secondary-60); }
.stacked-btn-secondary:hover { background-color: var(--secondary-50); color: var(--neutral-white); }
.stacked-btn-tertiary:hover  { background-color: var(--primary-60); }
.stacked-btn-gxscore:hover   { background-color: var(--gx-80); }
</style>

