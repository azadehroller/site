---
interface QuickLink {
  _key?: string;
  label: string;
  url: string;
  icon?: string;
  isExternal?: boolean;
}

interface FooterLink {
  _key?: string;
  label: string;
  url: string;
  isExternal?: boolean;
}

interface FooterColumn {
  _key?: string;
  title: string;
  links: FooterLink[];
}

interface Props {
  quickLinks?: QuickLink[];
  columns?: FooterColumn[];
}

const { quickLinks = [], columns = [] } = Astro.props;
---

{quickLinks.length > 0 && (
  <>
    <div class="footer-quick-links flex flex-wrap">
      {quickLinks.map((link) => (
        <a
          href={link.url}
          class="footer-quick-link flex items-center"
          target={link.isExternal ? '_blank' : undefined}
          rel={link.isExternal ? 'noopener noreferrer' : undefined}
        >
          {link.icon && (
            <span class="footer-quick-link__icon flex-center" set:html={link.icon}></span>
          )}
          {link.label}
        </a>
      ))}
    </div>
    <div class="footer-divider"></div>
  </>
)}

{columns.length > 0 && (
  <nav class="footer-nav grid grid-cols-5" aria-label="Footer Navigation">
    {columns.map((column) => (
      <div class="footer-nav-column stack">
        <h3 class="footer-nav-column__title inline-block">{column.title}</h3>
        {column.links && column.links.length > 0 && (
          <div class="footer-nav-column__links stack">
            {column.links.map((link) => (
              <a
                href={link.url}
                class="footer-nav-link block"
                target={link.isExternal ? '_blank' : undefined}
                rel={link.isExternal ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </nav>
)}

<style>
  .footer-divider {
    height: 1px;
    background: var(--white-alpha-30);
    width: 100%;
  }

  .footer-quick-links {
    gap: var(--spacing-6);
    padding: var(--spacing-4) 0;
    list-style: none;
    margin: 0;
  }

  .footer-quick-link {
    gap: var(--spacing-1);
    color: var(--neutral-white);
    text-decoration: none;
    font-size: var(--font-size-14);
    line-height: var(--line-height-21);
    transition: opacity 0.2s ease;
  }

  .footer-quick-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .footer-quick-link__icon {
    width: 16px;
    height: 16px;
  }

  .footer-nav {
    gap: var(--spacing-8);
    font-size: var(--font-size-14);
  }

  .footer-nav-column {
    gap: var(--spacing-4);
  }

  .footer-nav-column__title {
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-800);
    line-height: var(--line-height-21);
    color: var(--neutral-white);
    margin: 0;
    cursor: auto;
    margin-block-end: var(--size-3, 12px);
  }

  .footer-nav-column__title:hover {
    text-decoration: none;
  }

  .footer-nav-column__links {
    gap: var(--spacing-1);
    margin-block-end: var(--size-3, 12px);
  }

  .footer-nav-column__links a {
    line-height: var(--line-height-24);
    padding: 0.125rem 0;
  }

  .footer-nav-link {
    color: var(--neutral-10);
    text-decoration: none;
    font-size: var(--font-size-14);
    line-height: var(--line-height-21);
    transition: opacity 0.2s ease;
  }

  .footer-nav-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .footer-nav {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-quick-links {
      flex-direction: column;
      gap: var(--spacing-3);
    }
  }

  @media (max-width: 480px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) {
    .footer-quick-links {
      display: flex;
      gap: var(--size-6, 24px);
    }

    .footer-nav {
      grid-template-columns: repeat(5, 1fr);
      font-size: var(--font-size-14);
    }

    .footer-nav-column__links a {
      padding: 0.125rem 0;
    }
  }
</style>
