---
import type { HeaderMegaMenu } from "@utils/sanity";

interface Props {
  megaMenu: HeaderMegaMenu;
}

const { megaMenu } = Astro.props;
---

<style is:global>
  /* Mega dropdown panel */
  .menu-drop-panel {
    overflow: hidden;
    transition: all 0.4s ease;
    height: 0;
    cursor: auto;
    visibility: hidden;
    opacity: 0;
  }

  .mega-drop {
    position: static;
    width: 100vw;
  }

  @media (min-width: 992px) {
    .mega-drop {
      position: absolute;
      top: 80px;
      left: 0;
      z-index: 9;
    }
  }

  .mega-drop-wrapper {
    background: var(--neutral-white, #ffffff);
    padding: var(--spacing-4);
  }

  @media (min-width: 992px) {
    .mega-drop-wrapper {
      padding: var(--spacing-12) 2rem 4rem;
      box-shadow: 0 10px 40px var(--black-alpha-10);
    }
  }

  .mega-drop-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    max-width: 1312px;
    margin: 0 auto;
  }

  /* ── Top-level flex wrapper ── */
  .mega-drop-inner {
    display: flex;
    gap: var(--spacing-8);
    align-items: flex-start;
    max-width: 1312px;
    margin: 0 auto;
  }

  .mega-drop__intro {
    max-width: 305px;
    display: none;
  }

  @media (min-width: 992px) {
    .mega-drop__intro {
      display: block;
    }
  }

  .mega-drop__intro-title {
    font-size: var(--font-size-36);
    font-weight: var(--font-weight-800);
    color: var(--primary-50, #033180);
    line-height: var(--line-height-18);
    margin-block-end: var(--spacing-3);
  }

  .mega-drop__intro-desc {
    font-size: var(--font-size-16);
    color: var(--primary-50, #033180);
  }

  /* ── Alt-grid layout (Why ROLLER? / Solutions without intro): 3-col grid ── */
  .mega-drop__layout-alt {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-3);
    flex: 1;
  }

  @media (min-width: 768px) {
    .mega-drop__layout-alt {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--spacing-8);
    }
  }

  /* CTA inside the alt grid spans all columns */
  .mega-drop__layout-alt .mega-drop__cta {
    grid-column: 1 / -1;
    margin-block-start: var(--spacing-2);
  }

  /* Subintro headings — each occupies its own grid cell as a column header */
  .mega-drop__subintro {
    display: none;
  }

  @media (min-width: 768px) {
    .mega-drop__subintro { display: block; }
  }

  /* Item description text in the alt-grid layout */
  .mega-drop__item-subdesc {
    font-size: var(--font-size-14);
    color: var(--neutral-50, #808080);
    line-height: var(--line-height-21);
    margin-block-start: var(--spacing-1);
  }

  /* ── Alt-items container for layouts with intro (Industries): 2-col grid ── */
  .mega-drop__alt-items {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-1) var(--spacing-3);
    align-content: start;
  }

  /* ── Default layout wrapper: intro + items side by side at desktop ── */
  .mega-drop__layout-default {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  @media (min-width: 992px) {
    .mega-drop__layout-default {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--spacing-8);
    }
  }

  /* ── Items: single column list ── */
  .mega-drop__items-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  /* ── Separator: thin vertical line before featured panel ── */
  .mega-drop__separator {
    position: relative;
  }

  .mega-drop__separator::after {
    content: '';
    position: absolute;
    width: 1px;
    height: 100%;
    background-color: var(--neutral-20, #e5e7eb);
    top: 0;
    right: calc(-1 * var(--spacing-4));
  }

  /* ── Individual item row ── */
  .mega-drop__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    text-decoration: none;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: 10px;
    transition: background-color 0.2s ease;
  }

  .mega-drop__item:hover {
    background-color: var(--blue-99, #f5f8ff);
  }

  /* ── Icon circle ── */
  .mega-drop__item-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-color: var(--primary-10, #cedffd);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .mega-drop__item-icon svg,
  .mega-drop__item-icon img {
    width: 28px;
    height: 28px;
  }

  .mega-drop__item-text { flex: 1; }

  .mega-drop__item-title {
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-700);
    color: var(--primary-50, #033180);
    margin-block-end: var(--spacing-1);
    transition: color 0.2s ease;
  }

  .mega-drop__item:hover .mega-drop__item-title {
    color: var(--secondary-50, #ff290c);
  }

  /* ── Inline feature row: "Top features: [badge] [badge]" ── */
  .mega-drop__item-desc {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-1);
  }

  @media (min-width: 992px) {
    .mega-drop__item-desc { display: flex; }
  }

  /* "Top features:" inline label */
  .mega-drop__item-desc > span {
    font-size: var(--font-size-13);
    font-weight: var(--font-weight-500);
    color: var(--neutral-50, #808080);
    white-space: nowrap;
  }

  /* ── Feature badge: inline pill ── */
  .mega-drop__feature-badge {
    display: inline-flex;
    align-items: center;
    font-size: var(--font-size-13);
    font-weight: var(--font-weight-500);
    color: var(--primary-50, #033180);
    text-decoration: none;
    padding: 2px var(--spacing-2);
    background: var(--blue-99, #f0f4ff);
    border: 1px solid var(--primary-10, #cedffd);
    border-radius: 999px;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .mega-drop__feature-badge:hover {
    background: var(--primary-10, #cedffd);
    color: var(--primary-50, #033180);
  }

  /* ── Featured sidebar panel ── */
  .mega-drop__featured {
    width: 240px;
    flex-shrink: 0;
    display: none;
  }

  @media (min-width: 992px) {
    .mega-drop__featured { display: block; }
  }

  .mega-drop__featured-label {
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-800);
    color: var(--secondary-50, #ff290c);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-block-end: var(--spacing-3);
  }

  .mega-drop__featured-item {
    display: block;
    background: var(--primary-10, #cedffd);
    border-radius: 10px;
    margin-block-end: var(--spacing-3);
    text-decoration: none;
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .mega-drop__featured-item:hover {
    box-shadow: 0 4px 16px rgba(3, 49, 128, 0.12);
  }

  .mega-drop__featured-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .mega-drop__featured-item-content {
    padding: var(--spacing-3);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .mega-drop__featured-item-title {
    font-size: var(--font-size-15);
    font-weight: var(--font-weight-600);
    color: var(--primary-50, #033180);
    line-height: var(--line-height-22);
    margin-block-end: var(--spacing-1);
  }

  .mega-drop__featured-item-label {
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-500);
    color: var(--primary-40, #074dc5);
  }

  /* ── CTA link ── */
  .mega-drop__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-600);
    color: var(--primary-50, #033180);
    text-decoration: none;
    margin-block-start: var(--spacing-4);
    transition: color 0.2s ease;
  }

  .mega-drop__cta:hover { color: var(--secondary-50, #ff290c); }

  .mega-drop__cta svg {
    transition: transform 0.2s ease;
  }

  .mega-drop__cta:hover svg { transform: translateX(4px); }

  .mega-drop__cta:hover svg path { fill: var(--secondary-50, #ff290c); }

  /* CTA inside the 2-col grid spans both columns */
  .mega-drop__items-container .mega-drop__cta {
    grid-column: 1 / -1;
    margin-block-start: var(--spacing-2);
  }

  /* Industries alt-layout CTA spans the 2-col grid */
  .mega-drop__alt-items .mega-drop__alt-cta {
    grid-column: 1 / -1;
    margin-block-start: var(--spacing-2);
  }

  /* Prevent browser default link underline on items used as <a> */
  a.mega-drop__item,
  a.mega-drop__item:hover {
    text-decoration: none;
  }
</style>

<div class="menu-drop-panel mega-drop">
  <div class="mega-drop-wrapper">
    <div class="mega-drop-inner">
      <div class:list={[
        (megaMenu.useAlternateLayout && !megaMenu.introTitle)
          ? "mega-drop__layout-alt"
          : "mega-drop__layout-default",
        "mega-drop__separator"
      ]}>
        {/* Intro panel — shown when introTitle is set (Features + Industries) */}
        {megaMenu.introTitle && (
          <div class="mega-drop__intro">
            <p class="mega-drop__intro-title">{megaMenu.introTitle}</p>
            {megaMenu.introDescription && (
              <p class="mega-drop__intro-desc">{megaMenu.introDescription}</p>
            )}
          </div>
        )}

        {/* ── Default layout (Features): single-col, icon + title + description + badges ── */}
        {!megaMenu.useAlternateLayout && (
          <div class="mega-drop__items-container">
            {megaMenu.items?.map((menuItem) => (
              <div class="mega-drop__item">
                {menuItem.icon && (
                  <div class="mega-drop__item-icon" set:html={menuItem.icon}></div>
                )}
                <div class="mega-drop__item-text">
                  <a
                    href={menuItem.link?.href || '#'}
                    target={menuItem.link?.openInNewTab ? '_blank' : undefined}
                  >
                    <p class="mega-drop__item-title">{menuItem.title}</p>
                  </a>
                  <div class="mega-drop__item-desc">
                    {menuItem.description && (
                      <span>{menuItem.description}</span>
                    )}
                    {Array.isArray(menuItem.topFeatures) && menuItem.topFeatures.length > 0 && (
                      <>
                        {menuItem.topFeatures.map((feature) => {
                          if (feature.link && feature.title) {
                            return (
                              <a href={feature.link} class="mega-drop__feature-badge">
                                {feature.title}
                              </a>
                            );
                          }
                          return null;
                        })}
                      </>
                    )}
                  </div>
                </div>
              </div>
            ))}

            {megaMenu.ctaLabel && megaMenu.ctaLink && (
              <a href={megaMenu.ctaLink} class="mega-drop__cta">
                {megaMenu.ctaLabel}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none">
                  <path fill="var(--blue-30)" d="M8 0 6.59 1.41 12.17 7H0v2h12.17l-5.58 5.59L8 16l8-8-8-8Z"/>
                </svg>
              </a>
            )}
          </div>
        )}

        {/* ── Alt layout WITH intro (Industries): 2-col grid, icon + title ── */}
        {megaMenu.useAlternateLayout && megaMenu.introTitle && (
          <div class="mega-drop__alt-items">
            {megaMenu.items?.map((menuItem) => (
              <a
                href={menuItem.link?.href || '#'}
                class="mega-drop__item"
                target={menuItem.link?.openInNewTab ? '_blank' : undefined}
              >
                {menuItem.icon && (
                  <div class="mega-drop__item-icon" set:html={menuItem.icon}></div>
                )}
                <p class="mega-drop__item-title">{menuItem.title}</p>
              </a>
            ))}
            {megaMenu.ctaLabel && megaMenu.ctaLink && (
              <a href={megaMenu.ctaLink} class="mega-drop__cta mega-drop__alt-cta">
                {megaMenu.ctaLabel}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none">
                  <path fill="var(--blue-30)" d="M8 0 6.59 1.41 12.17 7H0v2h12.17l-5.58 5.59L8 16l8-8-8-8Z"/>
                </svg>
              </a>
            )}
          </div>
        )}

        {/* ── Alt layout WITHOUT intro (Why ROLLER? / Solutions): 3-col grid, subIntros as column headers ── */}
        {megaMenu.useAlternateLayout && !megaMenu.introTitle && (
          <>
            {megaMenu.subIntros?.map((subIntro) => (
              <div class="mega-drop__subintro">
                <p class="text-base font-extrabold text-secondary-50 margin-0">{subIntro.title}</p>
              </div>
            ))}
            {megaMenu.items?.map((menuItem) => (
              <a
                href={menuItem.link?.href || '#'}
                class="mega-drop__item"
                target={menuItem.link?.openInNewTab ? '_blank' : undefined}
              >
                <div class="mega-drop__item-text">
                  <p class="mega-drop__item-title">{menuItem.title}</p>
                  {menuItem.description && (
                    <p class="mega-drop__item-subdesc">{menuItem.description}</p>
                  )}
                </div>
              </a>
            ))}
            {megaMenu.ctaLabel && megaMenu.ctaLink && (
              <a href={megaMenu.ctaLink} class="mega-drop__cta">
                {megaMenu.ctaLabel}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none">
                  <path fill="var(--blue-30)" d="M8 0 6.59 1.41 12.17 7H0v2h12.17l-5.58 5.59L8 16l8-8-8-8Z"/>
                </svg>
              </a>
            )}
          </>
        )}
      </div>

      {/* Featured section */}
      {megaMenu.featuredItems && megaMenu.featuredItems.length > 0 && (
        <div class="mega-drop__featured">
          {megaMenu.featuredLabel && (
            <p class="mega-drop__featured-label">{megaMenu.featuredLabel}</p>
          )}
          {megaMenu.featuredItems.map((featured) => (
            <div class="mega-drop__featured-item">
              <a
                href={featured.link?.href || '#'}
                class="font-serif"
                target={featured.link?.openInNewTab ? '_blank' : undefined}
              >
                {featured.image?.asset?.url && (
                  <img
                    src={featured.image.asset.url}
                    class="card__image"
                    alt={featured.title}
                    loading="lazy"
                  />
                )}
                <div class="mega-drop__featured-item-content">
                  <p class="mega-drop__featured-item-title margin-0">{featured.title}</p>
                  {featured.label && (
                    <p class="mega-drop__featured-item-label margin-0">{featured.label}</p>
                  )}
                </div>
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
