---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="blog-header">
  <div class="blog-header__inner">
    <h1 class="blog-header__heading">{title}</h1>
    <p class="blog-header__text">
      Insights, tips, and trends to help you run a successful attraction business.
    </p>
    <div class="blog-header__search-wrapper relative">
      <div class="blog-header__search flex items-center">
        <div class="blog-header__search--input">
          <input
            type="text"
            id="blog-search-input"
            class="blog-search-input"
            placeholder="Search articles..."
            aria-label="Search articles"
            autocomplete="off"
          />
        </div>
        <div class="blog-header__search--icon flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
            <path fill="var(--neutral-white)" fill-rule="evenodd" d="M14.71 14h.79l4.99 5L19 20.49l-5-4.99v-.79l-.27-.28A6.471 6.471 0 0 1 9.5 16 6.5 6.5 0 1 1 16 9.5c0 1.61-.59 3.09-1.57 4.23l.28.27ZM5 9.5C5 11.99 7.01 14 9.5 14S14 11.99 14 9.5 11.99 5 9.5 5 5 7.01 5 9.5Z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>
      <div id="blog-search-results" class="blog-search-results" aria-live="polite"></div>
    </div>
  </div>
</div>

<style>
  .blog-header {
    background: linear-gradient(135deg, var(--blue-45) 0%, var(--primary-50) 100%);
    color: var(--neutral-white);
    margin-block-end: var(--spacing-10);
    padding: 60px 0;
  }

  .blog-header__inner {
    margin: 0 auto;
    max-width: 1300px;
    padding: 0 var(--spacing-5);
    text-align: center;
  }

  .blog-header__heading {
    margin-block-end: var(--spacing-4);
    font-size: var(--font-size-32);
    text-transform: capitalize;
  }

  @media (min-width: 768px) {
    .blog-header__heading {
      font-size: var(--font-size-48);
    }
  }

  .blog-header__text {
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-500);
    line-height: var(--line-height-28);
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.9;
  }

  @media (min-width: 992px) {
    .blog-header__text {
      font-size: var(--font-size-18);
      line-height: var(--line-height-28);
    }
  }

  .blog-header__search {
    padding: 10px 20px;
    background: var(--white-alpha-10);
    border-radius: 50px;
    backdrop-filter: blur(10px);
  }

  .blog-header__search--input {
    flex: 1;
  }

  .blog-search-input {
    background: transparent;
    border: none;
    color: var(--neutral-white);
    font-size: var(--font-size-16);
    outline: none;
    width: 100%;
  }

  .blog-search-input::placeholder {
    color: var(--white-alpha-80);
  }

  .blog-header__search-wrapper {
    max-width: 400px;
    margin: 1.6rem auto 0;
  }

  .blog-search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--neutral-white);
    border-radius: 8px;
    box-shadow: 0 4px 20px var(--black-alpha-15);
    max-height: 320px;
    overflow-y: auto;
    z-index: 100;
    display: none;
    margin-block-start: var(--spacing-2);
    text-align: left;
  }

  .blog-search-results.active {
    display: block;
  }

  /* Use :global() for dynamically inserted content */
  .blog-search-results :global(.blog-search-results__list) {
    list-style: none;
    margin: 0;
    padding: var(--spacing-3) 0;
  }

  .blog-search-results :global(.blog-search-results__list li) {
    margin: 0;
    padding: 0;
    text-align: left;
  }

  .blog-search-results :global(.blog-search-results__list li a) {
    display: block;
    padding: var(--spacing-3) var(--spacing-5);
    text-decoration: none;
    color: var(--primary-50);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-500);
    transition: background-color 0.15s ease;
    text-align: left;
  }

  .blog-search-results :global(.blog-search-results__list li a:hover) {
    background-color: var(--blue-99);
  }

  .blog-search-results :global(.blog-search-results__list li a strong) {
    font-weight: var(--font-weight-700);
    color: var(--primary-50);
  }

  .blog-search-results :global(.blog-search-results__loading),
  .blog-search-results :global(.blog-search-results__empty) {
    padding: var(--spacing-4) var(--spacing-5);
    text-align: left;
    color: var(--neutral-58);
    font-size: var(--font-size-14);
  }
</style>
