---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  useQueryParams?: boolean;
}

const { currentPage, totalPages, baseUrl, useQueryParams = false } = Astro.props;

// Generate page numbers to show
const getPageNumbers = () => {
  const pages: (number | string)[] = [];
  const showEllipsis = totalPages > 7;
  
  if (!showEllipsis) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    // Always show first page
    pages.push(1);
    
    if (currentPage > 3) {
      pages.push('...');
    }
    
    // Show pages around current
    for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
      pages.push(i);
    }
    
    if (currentPage < totalPages - 2) {
      pages.push('...');
    }
    
    // Always show last page
    if (totalPages > 1) {
      pages.push(totalPages);
    }
  }
  
  return pages;
};

const pageNumbers = getPageNumbers();

const getPageUrl = (page: number) => {
  if (useQueryParams) {
    // Use query parameters for topic pages
    if (page === 1) {
      return baseUrl;
    }
    return `${baseUrl}?page=${page}`;
  } else {
    // Use path segments for blog listing pages
    return page === 1 ? '/' : `${baseUrl}/${page}`;
  }
};
---

<nav class="blog-pagination" aria-label="Pagination">
  <div class="blog-pagination__nav flex items-center">
    {/* Previous button */}
    {currentPage > 1 ? (
      <a
        href={getPageUrl(currentPage - 1)}
        class="blog-pagination__prev-link inline-flex items-center"
        aria-label="Previous page"
      >
        <svg width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 .333 5.825 1.508l4.65 4.659H.333v1.666h10.142l-4.65 4.659L7 13.667 13.667 7 7 .333Z" fill="var(--blue-35)"/>
        </svg>
        <span>Previous</span>
      </a>
    ) : (
      <span class="blog-pagination__prev-link blog-pagination__prev-link--disabled inline-flex items-center">
        <svg width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 .333 5.825 1.508l4.65 4.659H.333v1.666h10.142l-4.65 4.659L7 13.667 13.667 7 7 .333Z" fill="var(--blue-grey-30)"/>
        </svg>
        <span>Previous</span>
      </span>
    )}

    {/* Page numbers */}
    <div class="blog-pagination__items flex items-center">
      {pageNumbers.map((page) => (
        typeof page === 'number' ? (
          page === currentPage ? (
            <span
              class="blog-pagination__link blog-pagination__link--active inline-flex"
              aria-current="page"
            >
              {page}
            </span>
          ) : (
            <a
              href={getPageUrl(page)}
              class="blog-pagination__link blog-pagination__number-link inline-flex"
            >
              {page}
            </a>
          )
        ) : (
          <span class="blog-pagination__ellipsis">...</span>
        )
      ))}
    </div>

    {/* Next button */}
    {currentPage < totalPages ? (
      <a
        href={getPageUrl(currentPage + 1)}
        class="blog-pagination__next-link inline-flex items-center"
        aria-label="Next page"
      >
        <span>Next</span>
        <svg width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 .333 5.825 1.508l4.65 4.659H.333v1.666h10.142l-4.65 4.659L7 13.667 13.667 7 7 .333Z" fill="var(--blue-35)"/>
        </svg>
      </a>
    ) : (
      <span class="blog-pagination__next-link blog-pagination__next-link--disabled inline-flex items-center">
        <span>Next</span>
        <svg width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 .333 5.825 1.508l4.65 4.659H.333v1.666h10.142l-4.65 4.659L7 13.667 13.667 7 7 .333Z" fill="var(--blue-grey-30)"/>
        </svg>
      </span>
    )}
  </div>
</nav>

<style>
  .blog-pagination {
    margin-block-end: 3.3rem;
    padding: var(--spacing-4) 0 0;
    text-align: center;
  }

  @media (min-width: 992px) {
    .blog-pagination {
      align-items: center;
      display: flex;
      justify-content: space-between;
    }
  }

  .blog-pagination__nav {
    gap: var(--spacing-2);
  }

  @media (min-width: 992px) {
    .blog-pagination__nav {
      padding: 0;
      width: 100%;
      justify-content: space-between;
    }
  }

  .blog-pagination__nav a {
    padding: 0 12px;
  }

  .blog-pagination__link {
    color: var(--blue-30);
    font-size: var(--font-size-16);
    line-height: var(--line-height-16);
    text-decoration: none;
    font-weight: var(--font-weight-700);
    transition: all 0.2s ease;
  }

  .blog-pagination__link:focus,
  .blog-pagination__link:hover {
    text-decoration: none;
  }

  .blog-pagination__number-link {
    padding: 6px 9px;
    font-weight: var(--font-weight-500);
  }

  .blog-pagination__number-link:not(.blog-pagination__link--active):focus,
  .blog-pagination__number-link:not(.blog-pagination__link--active):hover {
    font-weight: var(--font-weight-500);
    text-decoration: underline;
  }

  .blog-pagination__link--active {
    font-weight: var(--font-weight-700);
    pointer-events: none;
  }

  .blog-pagination__ellipsis {
    pointer-events: none;
    color: var(--blue-30);
    font-size: var(--font-size-15);
    padding: 6px;
  }

  .blog-pagination__prev-link,
  .blog-pagination__next-link {
    gap: var(--spacing-1);
    text-decoration: none;
    color: var(--blue-30);
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-700);
    transition: all 0.2s ease;
  }

  .blog-pagination__prev-link {
    margin-inline-end: var(--spacing-1);
    text-align: right;
  }

  .blog-pagination__next-link {
    margin-inline-start: var(--spacing-1);
    text-align: left;
  }

  .blog-pagination__prev-link svg {
    transform: rotate(180deg);
  }

  .blog-pagination__prev-link--disabled,
  .blog-pagination__next-link--disabled {
    display: none;
  }

  @media (min-width: 992px) {
    .blog-pagination__prev-link--disabled,
    .blog-pagination__next-link--disabled {
      display: inline-flex;
      color: var(--blue-grey-30);
      cursor: default;
      pointer-events: none;
    }
  }

  .blog-pagination__items {
    gap: var(--spacing-2);
  }
</style>



